# Copy to ~/.config/mfp-mason/mason.env and `chmod 600` it. Non-secret Mason
# settings, loaded by the service at every start: run `bin/mfpctl restart`
# after editing. (`scripts/install-mac.sh --username NAME` writes MFP_USERNAME.)
# Do NOT put MFP_COOKIE here; use `mfp-mcp auth` instead.
#
# curl_cffi browser fingerprint; try chrome124 if you see 403 / Cloudflare.
#MFP_IMPERSONATE=chrome124
# Your MFP username (not email). REQUIRED for SSO (Google/Apple) and email
# logins: MFP's profile endpoint returns 500 for them.
#MFP_USERNAME=
# Gap-fill lookback window in days (Mason default 30).
#MFP_SYNC_DAYS=30
