# Optional: copy to ~/.config/mfp-mason/mason.env. Non-secret Mason tuning.
# Re-run `bin/mfpctl install` after editing so the service picks it up.
# Do NOT put MFP_COOKIE here; use `mfp-mcp auth` instead.
#
# curl_cffi browser fingerprint; try chrome124 if you see 403 / Cloudflare.
#MFP_IMPERSONATE=chrome124
# Your MFP username (not email), only if Mason can't read your profile.
#MFP_USERNAME=
# Gap-fill lookback window in days (Mason default 30).
#MFP_SYNC_DAYS=30
