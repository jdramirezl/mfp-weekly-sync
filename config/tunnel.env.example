# Copy to ~/.config/mfp-mason/tunnel.env and `chmod 600` it. NEVER commit.
# Only needed if you enable the optional ChatGPT tunnel (`mfpctl tunnel enable`).
#
# OpenAI Platform -> Tunnels: the tunnel id (tunnel_...).
CONTROL_PLANE_TUNNEL_ID=
# OpenAI Platform -> Runtime API keys: Restricted, Tunnels Read + Use only.
CONTROL_PLANE_API_KEY=
