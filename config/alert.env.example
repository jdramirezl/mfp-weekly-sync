# Copy to ~/.config/mfp-mason/alert.env and `chmod 600` it. NEVER commit.
# Used by the daily health check to message you on Telegram when something
# breaks or recovers. This is the same bot token assistant-hub uses.
# If you rotate the token, update it here AND in assistant-hub's .env.
#
# Bot token from @BotFather (format 123456789:ABC...).
TELEGRAM_BOT_TOKEN=
# Your numeric Telegram user/chat id (the hub's TELEGRAM_ALLOWED_USER_IDS).
TELEGRAM_CHAT_ID=
