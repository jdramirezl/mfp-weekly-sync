#!/bin/bash
# mfpctl: manage the Mason MyFitnessPal MCP LaunchAgents on this Mac.
# Run `mfpctl help` for commands. Every mutating command accepts --dry-run.
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
# shellcheck source=../scripts/lib/common.sh
. "$REPO_ROOT/scripts/lib/common.sh"

usage() {
  cat <<'EOF'
Usage: mfpctl [--dry-run] <command> [args]

Service commands:
  install            Render and load the Mason service (plus health check and weekly refresh).
  uninstall          Unload and remove every mfp-mason LaunchAgent. Keeps your data.
  start              Load/start the Mason service.
  stop               Unload the Mason service (KeepAlive would restart a plain kill).
  restart            Restart the Mason service in place.
  status             Show launchd state and probe the MCP endpoint.
  logs [-f]          Show (or follow) the service logs.

Session:
  auth [--username NAME]
                     Re-authenticate from a piped cookie: pbpaste | mfpctl auth
  refresh            Rotate the MFP session now (runs weekly, Sunday 04:30).
  login [--timeout S]
                     Log the bot in with its own email + Keychain password
                     (opens a Chromium window; run at the Mac's screen).

Health:
  health [--simulate-fail mcp|auth|tunnel] [--wait SECONDS]
                     Run the health check now (alerts on Telegram when state changes).

Optional ChatGPT tunnel (off by default):
  tunnel enable      Install and load the tunnel-client service.
  tunnel disable     Unload and remove the tunnel-client service.
  tunnel status      Show the tunnel service and its /readyz.

Global options:
  --dry-run          Print what would be written and run; change nothing.
  -h, --help         Show this help.
EOF
}

# --- argument parsing (global flags may appear anywhere) --------------------
ARGS=()
for a in "$@"; do
  case "$a" in
    --dry-run) DRY_RUN=1 ;;
    -h | --help)
      usage
      exit 0
      ;;
    *) ARGS+=("$a") ;;
  esac
done
export DRY_RUN
set -- ${ARGS[@]+"${ARGS[@]}"}

mfp_init_paths
DOMAIN="gui/$(id -u)"

case "$MFP_PORT" in
  '' | *[!0-9]*) die "MFP_PORT must be a number (got '$MFP_PORT')" ;;
esac

plist_path() { printf '%s/%s.plist' "$LAUNCH_AGENTS_DIR" "$1"; }
is_loaded() { launchctl print "$DOMAIN/$1" >/dev/null 2>&1; }

# --- rendering ------------------------------------------------------------------
render_mason() {
  local bin="$1"
  require_loopback_host
  render_template "$REPO_ROOT/launchd/$LABEL_MASON.plist.in" \
    "LABEL=$LABEL_MASON" \
    "MASON_SCRIPT=$(xml_escape "$RUNTIME_BIN_DIR/mason-run.sh")" \
    "MFP_MCP_BIN=$(xml_escape "$bin")" \
    "MFP_PORT=$MFP_PORT" \
    "SERVICE_PATH=$(xml_escape "$SERVICE_PATH_BASE:$(dirname "$bin")")" \
    "MFP_MCP_DATA_DIR=$(xml_escape "$MFP_MCP_DATA_DIR")" \
    "MFP_CONFIG_DIR=$(xml_escape "$MFP_CONFIG_DIR")" \
    "MFP_STATE_DIR=$(xml_escape "$MFP_STATE_DIR")" \
    "MFP_LOG_DIR=$(xml_escape "$MFP_LOG_DIR")"
}

# --- launchd plumbing -------------------------------------------------------------
RUNTIME_BIN_DIR="$MFP_STATE_DIR/bin"

# The LaunchAgents run copies of the scripts from the state dir, so moving or
# renaming this repo checkout never breaks the installed services.
install_runtime_scripts() {
  local f
  run mkdir -p "$RUNTIME_BIN_DIR/lib"
  for f in mason-run.sh health-check.sh tunnel-run.sh refresh-session.sh login-mfp.sh mfp_login.py; do
    [ -f "$REPO_ROOT/scripts/$f" ] || continue
    run cp "$REPO_ROOT/scripts/$f" "$RUNTIME_BIN_DIR/$f"
    run chmod 755 "$RUNTIME_BIN_DIR/$f"
  done
  run cp "$REPO_ROOT/scripts/lib/common.sh" "$RUNTIME_BIN_DIR/lib/common.sh"
  run chmod 644 "$RUNTIME_BIN_DIR/lib/common.sh"
}

render_health() {
  local bin="$1"
  render_template "$REPO_ROOT/launchd/$LABEL_HEALTH.plist.in" \
    "LABEL=$LABEL_HEALTH" \
    "HEALTH_SCRIPT=$(xml_escape "$RUNTIME_BIN_DIR/health-check.sh")" \
    "SERVICE_PATH=$(xml_escape "$SERVICE_PATH_BASE:$(dirname "$bin")")" \
    "MFP_MCP_BIN=$(xml_escape "$bin")" \
    "MFP_MCP_DATA_DIR=$(xml_escape "$MFP_MCP_DATA_DIR")" \
    "MFP_STATE_DIR=$(xml_escape "$MFP_STATE_DIR")" \
    "MFP_CONFIG_DIR=$(xml_escape "$MFP_CONFIG_DIR")" \
    "MFP_LOG_DIR=$(xml_escape "$MFP_LOG_DIR")" \
    "LAUNCH_AGENTS_DIR=$(xml_escape "$LAUNCH_AGENTS_DIR")" \
    "MFP_PORT=$MFP_PORT"
}
render_refresh() {
  local bin="$1"
  render_template "$REPO_ROOT/launchd/$LABEL_REFRESH.plist.in" \
    "LABEL=$LABEL_REFRESH" \
    "REFRESH_SCRIPT=$(xml_escape "$RUNTIME_BIN_DIR/refresh-session.sh")" \
    "SERVICE_PATH=$(xml_escape "$SERVICE_PATH_BASE:$(dirname "$bin")")" \
    "MFP_MCP_BIN=$(xml_escape "$bin")" \
    "MFP_TOOL_PY=$(xml_escape "$(resolve_tool_python)")" \
    "MFP_MCP_DATA_DIR=$(xml_escape "$MFP_MCP_DATA_DIR")" \
    "MFP_STATE_DIR=$(xml_escape "$MFP_STATE_DIR")" \
    "MFP_CONFIG_DIR=$(xml_escape "$MFP_CONFIG_DIR")" \
    "MFP_LOG_DIR=$(xml_escape "$MFP_LOG_DIR")" \
    "LAUNCH_AGENTS_DIR=$(xml_escape "$LAUNCH_AGENTS_DIR")" \
    "MFP_PORT=$MFP_PORT"
}

ensure_dirs() {
  local d
  for d in "$MFP_STATE_DIR" "$MFP_LOG_DIR"; do
    run mkdir -p "$d"
    run chmod 700 "$d"
  done
}

bootstrap() {
  local label="$1" plist
  plist="$(plist_path "$label")"
  if [ "$DRY_RUN" = 1 ]; then
    run launchctl bootstrap "$DOMAIN" "$plist"
    return
  fi
  # A bootout that just happened can make the next bootstrap fail briefly.
  local i
  for i in 1 2 3; do
    launchctl bootstrap "$DOMAIN" "$plist" && return 0
    [ "$i" = 3 ] || sleep 1
  done
  die "launchctl bootstrap failed for $label (see: launchctl print $DOMAIN/$label)"
}

bootout_if_loaded() {
  local label="$1"
  if is_loaded "$label"; then
    run launchctl bootout "$DOMAIN/$label" || true
  fi
}

# install_agent LABEL CONTENT : lint, write and (re)load one LaunchAgent.
install_agent() {
  local label="$1" content="$2" dest tmp
  [ -n "$content" ] || die "refusing to install an empty $label plist"
  dest="$(plist_path "$label")"
  tmp="$(mktemp "${TMPDIR:-/tmp}/$label.XXXXXX")"
  printf '%s\n' "$content" >"$tmp"
  if ! plutil -lint -s "$tmp" >/dev/null; then
    rm -f "$tmp"
    die "rendered $label plist failed plutil -lint"
  fi
  if [ "$DRY_RUN" = 1 ]; then
    printf -- '--- would write %s ---\n' "$dest"
    cat "$tmp"
    rm -f "$tmp"
    bootout_if_loaded "$label"
    bootstrap "$label"
    return
  fi
  mkdir -p "$LAUNCH_AGENTS_DIR"
  bootout_if_loaded "$label"
  mv "$tmp" "$dest"
  chmod 644 "$dest"
  bootstrap "$label"
  log "loaded $label"
}

remove_agent() {
  local label="$1" plist
  plist="$(plist_path "$label")"
  bootout_if_loaded "$label"
  if [ -e "$plist" ]; then
    run rm -f "$plist"
  fi
}

agent_summary() {
  local label="$1" info state pid
  if [ ! -e "$(plist_path "$label")" ]; then
    printf '%-24s not installed\n' "$label"
    return
  fi
  if ! info="$(launchctl print "$DOMAIN/$label" 2>/dev/null)"; then
    printf '%-24s installed, not loaded\n' "$label"
    return
  fi
  state="$(printf '%s\n' "$info" | sed -n 's/^[[:space:]]*state = //p' | head -n 1)"
  pid="$(printf '%s\n' "$info" | sed -n 's/^[[:space:]]*pid = //p' | head -n 1)"
  printf '%-24s loaded (state=%s%s)\n' "$label" "${state:-unknown}" "${pid:+, pid=$pid}"
}

# --- commands -----------------------------------------------------------------------
cmd_install() {
  local bin content health refresh
  require_loopback_host
  bin="$(resolve_mfp_mcp_bin)"
  content="$(render_mason "$bin")"
  health="$(render_health "$bin")"
  refresh="$(render_refresh "$bin")"
  ensure_dirs
  install_runtime_scripts
  install_agent "$LABEL_MASON" "$content"
  install_agent "$LABEL_HEALTH" "$health"
  install_agent "$LABEL_REFRESH" "$refresh"
  if ! configured_username >/dev/null; then
    warn "No MFP_USERNAME found in mason.env or Mason's saved session."
    warn "$USERNAME_HINT"
  fi
  [ "$DRY_RUN" = 1 ] || log "Mason is starting on $MFP_MCP_URL. Check with: mfpctl status"
}

cmd_uninstall() {
  local label
  for label in "$LABEL_TUNNEL" "$LABEL_REFRESH" "$LABEL_HEALTH" "$LABEL_MASON"; do
    remove_agent "$label"
  done
  log "Removed LaunchAgents. Mason data, session and logs were left in place."
}

cmd_start() {
  if is_loaded "$LABEL_MASON"; then
    run launchctl kickstart "$DOMAIN/$LABEL_MASON"
  elif [ -e "$(plist_path "$LABEL_MASON")" ]; then
    bootstrap "$LABEL_MASON"
  else
    die "not installed. Run: mfpctl install"
  fi
}

cmd_stop() {
  is_loaded "$LABEL_MASON" || {
    log "$LABEL_MASON is not loaded"
    return 0
  }
  run launchctl bootout "$DOMAIN/$LABEL_MASON"
}

cmd_restart() {
  is_loaded "$LABEL_MASON" || die "$LABEL_MASON is not loaded. Run: mfpctl start"
  run launchctl kickstart -k "$DOMAIN/$LABEL_MASON"
}

cmd_status() {
  local label server rc=0
  for label in "$LABEL_MASON" "$LABEL_HEALTH" "$LABEL_REFRESH" "$LABEL_TUNNEL"; do
    agent_summary "$label"
  done
  if server="$(mcp_initialize)"; then
    printf 'MCP %s: OK (%s)\n' "$MFP_MCP_URL" "$server"
  else
    printf 'MCP %s: UNREACHABLE\n' "$MFP_MCP_URL"
    rc=1
  fi
  return "$rc"
}

cmd_logs() {
  local files=() f
  for f in "$MFP_LOG_DIR"/*.log; do [ -e "$f" ] && files+=("$f"); done
  [ ${#files[@]} -gt 0 ] || die "no logs yet in $MFP_LOG_DIR"
  if [ "${1:-}" = -f ]; then
    exec tail -n 50 -f "${files[@]}"
  fi
  tail -n 50 "${files[@]}"
}

cmd_health() {
  local bin
  # Best effort: the health script reports a missing binary itself.
  if [ -z "${MFP_MCP_BIN:-}" ] && bin="$(DRY_RUN=0 resolve_mfp_mcp_bin 2>/dev/null)"; then
    export MFP_MCP_BIN="$bin"
  fi
  exec /bin/bash "$REPO_ROOT/scripts/health-check.sh" "$@"
}

cmd_login() {
  local bin
  if [ -z "${MFP_MCP_BIN:-}" ] && bin="$(DRY_RUN=0 resolve_mfp_mcp_bin 2>/dev/null)"; then
    export MFP_MCP_BIN="$bin"
  fi
  exec /bin/bash "$REPO_ROOT/scripts/login-mfp.sh" "$@"
}

cmd_refresh() {
  local bin
  if [ -z "${MFP_MCP_BIN:-}" ] && bin="$(DRY_RUN=0 resolve_mfp_mcp_bin 2>/dev/null)"; then
    export MFP_MCP_BIN="$bin"
  fi
  exec /bin/bash "$REPO_ROOT/scripts/refresh-session.sh" "$@"
}

# --- optional tunnel ---------------------------------------------------------------
resolve_tunnel_client_bin() {
  local p
  if [ -n "${TUNNEL_CLIENT_BIN:-}" ]; then
    case "$TUNNEL_CLIENT_BIN" in /*) ;; *) die "TUNNEL_CLIENT_BIN must be an absolute path" ;; esac
    printf '%s\n' "$TUNNEL_CLIENT_BIN"
  elif p="$(command -v tunnel-client 2>/dev/null)" && [ -n "$p" ]; then
    printf '%s\n' "$p"
  elif [ "$DRY_RUN" = 1 ]; then
    warn "tunnel-client not found; using a placeholder path for the dry run."
    printf '%s\n' "/opt/homebrew/bin/tunnel-client"
  else
    die "tunnel-client not found. Run: scripts/install-mac.sh --with-tunnel"
  fi
}

# Checks tunnel.env exists, is 0600 and has both keys, without loading or
# printing the values.
check_tunnel_env() {
  local f="$MFP_CONFIG_DIR/tunnel.env" mode key
  [ -f "$f" ] || die "missing $f. Copy tunnel.env.example to tunnel.env, fill it in, chmod 600."
  mode="$(file_mode "$f")"
  case "$mode" in 600 | 400) ;; *) die "$f has mode $mode; run: chmod 600 \"$f\"" ;; esac
  for key in CONTROL_PLANE_TUNNEL_ID CONTROL_PLANE_API_KEY; do
    grep -Eq "^(export )?${key}=[\"']?[^\"'[:space:]]" "$f" || die "$key is empty in $f"
  done
}

render_tunnel() {
  local bin="$1"
  render_template "$REPO_ROOT/launchd/$LABEL_TUNNEL.plist.in" \
    "LABEL=$LABEL_TUNNEL" \
    "TUNNEL_SCRIPT=$(xml_escape "$RUNTIME_BIN_DIR/tunnel-run.sh")" \
    "SERVICE_PATH=$(xml_escape "$SERVICE_PATH_BASE:$(dirname "$bin")")" \
    "TUNNEL_CLIENT_BIN=$(xml_escape "$bin")" \
    "MFP_CONFIG_DIR=$(xml_escape "$MFP_CONFIG_DIR")" \
    "MFP_PORT=$MFP_PORT" \
    "TUNNEL_HEALTH_ADDR=$(xml_escape "$TUNNEL_HEALTH_ADDR")" \
    "MFP_STATE_DIR=$(xml_escape "$MFP_STATE_DIR")" \
    "MFP_LOG_DIR=$(xml_escape "$MFP_LOG_DIR")"
}

cmd_tunnel() {
  local sub="${1:-}" bin content
  case "$sub" in
    enable)
      check_tunnel_env
      case "$TUNNEL_HEALTH_ADDR" in 127.0.0.1:*) ;; *) die "TUNNEL_HEALTH_ADDR must stay on 127.0.0.1" ;; esac
      bin="$(resolve_tunnel_client_bin)"
      [ -e "$(plist_path "$LABEL_MASON")" ] || warn "Mason service is not installed yet; run: mfpctl install"
      content="$(render_tunnel "$bin")"
      ensure_dirs
      install_runtime_scripts
      install_agent "$LABEL_TUNNEL" "$content"
      [ "$DRY_RUN" = 1 ] || log "Tunnel enabled. In ChatGPT add a Tunnel connector with your tunnel_ id and No authentication."
      ;;
    disable)
      remove_agent "$LABEL_TUNNEL"
      [ "$DRY_RUN" = 1 ] || log "Tunnel disabled. Mason itself keeps running for the hub."
      ;;
    status)
      agent_summary "$LABEL_TUNNEL"
      if curl -fsS --max-time 5 -o /dev/null "http://$TUNNEL_HEALTH_ADDR/readyz" 2>/dev/null; then
        printf 'tunnel-client http://%s/readyz: ready\n' "$TUNNEL_HEALTH_ADDR"
      else
        printf 'tunnel-client http://%s/readyz: NOT ready\n' "$TUNNEL_HEALTH_ADDR"
        return 1
      fi
      ;;
    *) die "usage: mfpctl tunnel enable|disable|status" ;;
  esac
}

cmd="${1:-help}"
[ $# -gt 0 ] && shift
case "$cmd" in
  install) cmd_install ;;
  uninstall) cmd_uninstall ;;
  start) cmd_start ;;
  stop) cmd_stop ;;
  restart) cmd_restart ;;
  status) cmd_status ;;
  logs) cmd_logs "$@" ;;
  health) cmd_health "$@" ;;
  refresh) cmd_refresh "$@" ;;
  login) cmd_login "$@" ;;
  auth) exec "$REPO_ROOT/bin/mfp-auth" "$@" ;;
  tunnel) cmd_tunnel "$@" ;;
  help) usage ;;
  *)
    usage >&2
    die "unknown command: $cmd"
    ;;
esac
