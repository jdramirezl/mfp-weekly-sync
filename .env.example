# Copy to .env and fill in. Loaded only on your local machine.
# NEVER commit the real .env — it is gitignored.
#
# Credentials for the live MyFitnessPal backend. Only needed when using
# `--backend myfitnesspal`. The mock backend ignores these entirely.
MFP_USERNAME=you@example.com
MFP_PASSWORD=your-mfp-password

# Backend selection: "mock" (default, safe) or "myfitnesspal" (live writes).
MFP_SYNC_BACKEND=mock

# Where local state (SQLite catalog + sync history + session token) lives.
# Defaults to ./.mfp-sync if unset.
MFP_SYNC_HOME=./.mfp-sync
